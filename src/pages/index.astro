---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Services from '../components/Services.astro';
import Gallery from '../components/Gallery.astro';
import Trust from '../components/Trust.astro';
import Location from '../components/Location.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { getClientData } from '../lib/client';
import { siteDeClientData } from '../lib/site';

export const prerender = true;

const client = getClientData();
const site = siteDeClientData(client);
---

<Base
  title={`${client.business.name} | ${client.business.neighborhood}`}
  description={client.business.description}
>
  <Hero site={site} />
  <Services site={site} />
  <Gallery site={site} />
  <Trust />
  <Location site={site} />
  <Footer site={site} />
  <WhatsAppFloat site={site} />
</Base>
