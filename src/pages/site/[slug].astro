---
import Base from '../../layouts/Base.astro';
import Hero from '../../components/Hero.astro';
import Services from '../../components/Services.astro';
import Gallery from '../../components/Gallery.astro';
import Location from '../../components/Location.astro';
import Footer from '../../components/Footer.astro';
import WhatsAppFloat from '../../components/WhatsAppFloat.astro';
import { sitePublico } from '../../lib/api';
import { siteDaLinhaEstetica } from '../../lib/site';

// Página pública do cliente: SSR de propósito. O conteúdo nasce do banco a cada
// visita, então não há HTML para pré-gerar no build.
const slug = (Astro.params.slug ?? '').trim().toLowerCase();

// Só um slug que já poderia ser um link válido chega à API. Qualquer outra
// coisa é "não encontrado" por definição, e a consulta nem acontece.
const SLUG_OK = /^[a-z0-9](?:[a-z0-9-]{1,61}[a-z0-9])?$/;

if (!SLUG_OK.test(slug)) {
  return Astro.redirect('/404');
}

// A API pública é a PublicoView do Django: sem login, sem e-mail do dono, sem CPF e
// sem id do Asaas (cobrado por teste em core/tests.py). O cookie da request não é
// repassado: não há sessão a manter aqui, e a resposta deste endpoint é cacheada no
// CDN (Cache-Control vindo da origem) — levar credencial para uma resposta cacheável
// é exatamente o tipo de coisa que vaza dado de uma conta para a visita seguinte.
const resultado = await sitePublico(slug, Astro.request.url);

if (!resultado.ok) {
  // 404 tem mensagem própria na API ("Página não encontrada.") e é o único caso em que
  // "não existe" não é "o servidor está fora do ar".
  if (resultado.status === 404) {
    return Astro.redirect('/404');
  }

  console.error('[site] falha ao consultar estética pública:', resultado.status, resultado.error);

  return new Response('Não foi possível carregar este site agora.', {
    status: 500,
    headers: { 'content-type': 'text/plain; charset=utf-8' },
  });
}

if (!resultado.data) {
  return Astro.redirect('/404');
}

const site = siteDaLinhaEstetica(resultado.data);
---

<Base title={site.business.name} description={site.business.description ?? ''}>
  <Hero site={site} />
  <Services site={site} />
  <Gallery site={site} />
  <Location site={site} />
  <Footer site={site} />
  <WhatsAppFloat site={site} />
</Base>
