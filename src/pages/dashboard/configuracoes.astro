---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { exigeSessao } from '../../lib/sessao';

// Mesmo crivo da tela principal: é a API que diz se há sessão (401 -> /login), e uma
// falha de servidor não se disfarça de "você saiu da conta".
const acesso = await exigeSessao(Astro);

if ('redirecionar' in acesso) {
  return acesso.redirecionar;
}

const { sessao } = acesso;
---

<DashboardLayout
  ativo="configuracoes"
  email={sessao.email}
  title="Configurações | Fator Brilho SaaS"
  description="Configurações da sua conta Fator Brilho."
>
  <h1 class="font-display text-4xl md:text-5xl font-bold tracking-tight">Configurações</h1>

  <div class="bg-slate-900 border border-slate-800 rounded-2xl p-8 max-w-2xl mt-10">
    <p class="text-slate-50 font-semibold">Esta tela ainda está em construção.</p>
    <p class="text-slate-300 mt-3">
      Nome, WhatsApp, Instagram, endereço, link do site e cor principal continuam em
      <a href="/dashboard" class="text-emerald-400 underline hover:text-emerald-300 transition-colors">Meu site</a>.
    </p>
  </div>
</DashboardLayout>
