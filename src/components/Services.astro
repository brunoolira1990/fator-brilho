---
import { getClientData } from '../lib/client';

const client = getClientData();
const quoteHref = (service: string) =>
  `https://wa.me/${client.business.whatsapp}?text=${encodeURIComponent(`Olá! Quero solicitar um orçamento para ${service}.`)}`;
---

<section class="bg-slate-900 py-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <h2 class="font-display text-4xl md:text-5xl font-bold uppercase tracking-tight text-center">
      Nossos Serviços
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mt-14">
      {
        client.services.map((service) => (
          <div class="bg-slate-800 border border-slate-700 hover:border-emerald-500 rounded-2xl p-8 flex flex-col justify-between transition-colors">
            <div>
              <h3 class="font-display text-2xl font-semibold">{service.name}</h3>
              <p class="text-sm text-slate-400 mt-3">{service.description}</p>
            </div>
            <div class="mt-6">
              <p class="text-3xl font-display text-emerald-400 mt-4">{service.priceFrom}</p>
              <a
                href={quoteHref(service.name)}
                aria-label={`Solicitar Orçamento para ${service.name}`}
                class="block mt-4 w-full py-3 bg-[var(--accent)] hover:bg-[color-mix(in_oklab,var(--accent),black_18%)] text-white font-bold rounded-lg transition-colors text-center"
                style={`--accent: ${client.branding.accentColor}`}
              >
                Solicitar Orçamento
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
