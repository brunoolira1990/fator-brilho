---
import { type SiteData } from '../lib/site';

interface Props {
  site: SiteData;
}

const { site } = Astro.props;

// Sem endereço não há mapa a mostrar: a seção sai da página inteira.
if (!site.business.address) {
  return;
}

const embedSrc = `https://www.google.com/maps?q=${encodeURIComponent(site.business.address)}`;
---

<section class="bg-slate-950 py-24 md:py-32">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <div>
        <h2 class="font-display text-4xl font-bold uppercase tracking-widest">Onde estamos</h2>

        <p class="text-slate-300 mt-6">{site.business.address}</p>

        {site.business.hours && <p class="text-slate-400 mt-2">{site.business.hours}</p>}

        {
          site.business.mapsUrl && (
            <a
              href={site.business.mapsUrl}
              class="inline-block mt-8 px-6 py-3 rounded-full font-semibold text-white text-base shadow-lg bg-[var(--accent)] hover:bg-[color-mix(in_oklab,var(--accent),black_18%)] hover:scale-105 transition duration-300"
              style={`--accent: ${site.branding.accentColor}`}
            >
              Como chegar
            </a>
          )
        }
      </div>

      <iframe
        src={embedSrc}
        title={`Mapa: ${site.business.name}`}
        class="w-full h-80 md:h-full min-h-[20rem] rounded-2xl border border-slate-800"
        style="border:0"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</section>
