---
import { getClientData } from '../lib/client';

const client = getClientData();
---

<section class="bg-slate-900 py-24 md:py-32">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    <div class="flex items-center justify-center gap-4">
      <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 576 512" class="w-16 h-16 md:w-20 md:h-20 fill-amber-400 drop-shadow-[0_0_22px_rgba(251,191,36,0.55)]" aria-hidden="true">
        <path d="M309.5-18.9c-4.1-8-12.4-13.1-21.4-13.1s-17.3 5.1-21.4 13.1L193.1 125.3 33.2 150.7c-8.9 1.4-16.3 7.7-19.1 16.3s-.5 18 5.8 24.4l114.4 114.5-25.2 159.9c-1.4 8.9 2.3 17.9 9.6 23.2s16.9 6.1 25 2L288.1 417.6 432.4 491c8 4.1 17.7 3.3 25-2s11-14.2 9.6-23.2L441.7 305.9 556.1 191.4c6.4-6.4 8.6-15.8 5.8-24.4s-10.1-14.9-19.1-16.3L383 125.3 309.5-18.9z" />
      </svg>
      <p class="font-display text-7xl md:text-8xl font-bold leading-none">{client.trust.googleRating}</p>
    </div>

    <p class="text-slate-400 mt-4">
      Baseado em {client.trust.googleReviewCount} avaliações
    </p>

    <a
      href={client.trust.googleReviewUrl}
      class="inline-block mt-6 text-base font-semibold text-emerald-400 hover:text-emerald-300 transition-colors"
    >
      Ver perfil no Google
    </a>
  </div>
</section>
