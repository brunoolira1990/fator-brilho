# Imagem do backend Django para o runtime de container da Vercel.
# Nome obrigatorio: Dockerfile.vercel vence a deteccao automatica de framework
# (a Vercel detectaria Django pelo manage.py e ignoraria um Dockerfile raiz).

# Base: python:3.13-slim, alinhado com backend-django/.python-version (= 3.13).
# slim e suficiente porque o requirements.txt usa psycopg2-binary (ja vem com
# binario), entao nao precisamos de build-essential/libpq-dev para compilar.
FROM python:3.13-slim

# So o codigo-fonte do projeto; o WORKDIR precisa ser absoluto porque o
# gerenciador de processos da Vercel pode mudar o diretorio de execucao.
WORKDIR /app

# Nao escrever .pyc e manter o stdout sem buffer: com um servidor web em
# primeiro plano, log em tempo real no painel da Vercel vale mais que
# performance de import.
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# Dependencias primeiro para aproveitar o cache de camadas do build.
# O gunicorn nao e mais instalado solto aqui: ele agora e pino no
# requirements.txt (gunicorn==26.2.0, a versao comprovada em producao),
# entao "-r requirements.txt" ja traz tudo que a imagem precisa.
COPY requirements.txt ./
RUN pip install --no-cache-dir -r requirements.txt

# Copiamos apenas o que o Django precisa em runtime (fatorbrilho/ e core/),
# em vez de "COPY . .", para que venv/, db.sqlite3, staticfiles/ e .env nao
# entrem na imagem. Atencao: se nascer um novo diretorio Python na raiz do
# backend, ele precisa ser adicionado aqui.
COPY manage.py ./
COPY fatorbrilho/ ./fatorbrilho/
COPY core/ ./core/

# Collectstatic NA CONSTRUCAO da imagem, nao no CMD: no runtime de container a
# Vercel nao roda collectstatic sozinha (isso era comportamento do antigo modo
# serverless), e o filesystem das instancias e somente leitura fora de /tmp --
# rodar no CMD ia dar erro em cada subida. Com o RUN abaixo os estaticos do
# admin, do Jazzmin e do core (core/static/core/admin/theme.css) ja vao
# embutidos na imagem e o WhiteNoise os serve de /static em tempo de execucao.
# Ordem obrigatoria: vem depois do COPY de fatorbrilho/ e core/ porque o
# collectstatic le settings.py e os diretorio static/ dos apps locais; os
# estaticos de terceiros ja estao no site-packages instalado acima.
# DJANGO_DEBUG fica desligado (padrao do settings) e STATIC_ROOT e relativo ao
# /app da imagem, um diretorio gravavel apenas no build -- exatamente o que
# queremos.
# DJANGO_BUILD_SEM_BANCO=1 so nesta linha: o settings.py recusa SQLite em deploy
# (sem DATABASE_URL + DJANGO_SECRET_KEY definida ele da ImproperlyConfigured), e o
# `docker build` ainda nao tem as variaveis do projeto injetadas. collectstatic nao
# abre conexao com o banco, entao liberar apenas este comando e seguro. Atribuicao
# inline (e nao ENV) porque ENV permaneceria no runtime e la a checagem e obrigatoria.
RUN DJANGO_BUILD_SEM_BANCO=1 python manage.py collectstatic --noinput

# SIGTERM: o gunicorn cuida do shutdown sozinho (drena os workers), e o "exec"
# abaixo faz dele o processo 1 para que o sinal chegue sem passar por shell.
# Porta 80 e o padrao de trafego do container na Vercel; ${PORT} so entra se o
# projeto definir a variavel, por isso o fallback :-80.
# O migrate roda ANTES do servidor (pedido explicito do dono) e com ";" em vez
# de "&&": se o migrate falhar (ex.: banco fora do ar), o servidor sobe mesmo
# assim e da pra ver o erro no log em vez de o container morrer em loop.
# O aviso abaixo vem antes do migrate por um motivo pratico: em 05/11/2026 o
# backend passou um deploy inteiro achando que tinha banco, e o unico sintoma
# visivel era o `id` voltando a 1. Agora o settings.py recusa SQLite em deploy,
# entao sem DATABASE_URL o container nem comeca -- e esta linha diz o porque no
# log, em vez de deixar o ImproperlyConfigured parecer pane da plataforma.
# Risco remanescente documentado no handoff: migrate concorrente entre instancias
# do autoscale (o Postgres trava a aplicacao com django_migrations, mas o segundo
# processo pode esperar ate ~10s no lock).
EXPOSE 80

CMD ["sh", "-c", "if [ -z \"$DATABASE_URL\" ] && [ -z \"$DATABASE_URL_UNPOOLED\" ]; then echo 'AVISO: nenhuma DATABASE_URL neste ambiente. O settings.py vai recusar SQLite e o container nao vai subir. Vincule o Neon ao projeto (Storage -> Neon) e redeploye.'; fi; python manage.py migrate --noinput; exec gunicorn fatorbrilho.wsgi:application --bind 0.0.0.0:${PORT:-80} --workers 2 --timeout 60 --access-logfile -"]
